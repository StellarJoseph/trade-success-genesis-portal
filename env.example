# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Example:
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... 

# Demo admin credentials (only for local/demo setups). Do NOT commit real secrets.
# If Supabase is configured, the app will use Supabase Auth instead.
VITE_DEMO_ADMIN_USERNAME=admin
VITE_DEMO_ADMIN_PASSWORD=admin123

# Force demo-only login (set to "true" to bypass Supabase and use demo creds)
# Useful for local development when auth isn't configured yet.
VITE_FORCE_DEMO=true